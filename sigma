				Name = "Fill",
				BackgroundColor3 = COLORS.Accent,
				Position = UDim2.new(0, 0, 0, 0),
				Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0),
				BorderSizePixel = 0,
				Parent = Track
			})

			Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Fill})

			local Knob = Create("Frame", {
				Name = "Knob",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = COLORS.Text,
				Position = UDim2.new((Value - Min) / (Max - Min), 0, 0.5, 0),
				Size = UDim2.fromOffset(ScaledNumber(10), ScaledNumber(10)),
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = Track
			})

			Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Knob})

			local KnobStroke = Create("UIStroke", {
				Color = COLORS.AccentDark,
				Thickness = ScaledNumber(1.5),
				Parent = Knob
			})

			local Dragging = false

			local function SetValue(NewVal)
				NewVal = math.clamp(NewVal, Min, Max)
				if Decimals == 0 then
					NewVal = math.round(NewVal)
				else
					NewVal = math.floor(NewVal * 10^Decimals + 0.5) / 10^Decimals
				end
				Value = NewVal
				local Ratio = (Value - Min) / (Max - Min)
				Fill.Size = UDim2.new(Ratio, 0, 1, 0)
				Knob.Position = UDim2.new(Ratio, 0, 0.5, 0)
				ValueLabel.Text = tostring(Value) .. Suffix
				Callback(Value)
			end

			local SliderBtn = Create("TextButton", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				Text = "",
				ZIndex = 10,
				Parent = TrackHolder
			})

			SliderBtn.InputBegan:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1 then
					Dragging = true
					local Ratio = math.clamp((Input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
					SetValue(Min + Ratio * (Max - Min))
				end
			end)

			UserInputService.InputChanged:Connect(function(Input)
				if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
					local Ratio = math.clamp((Input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
					SetValue(Min + Ratio * (Max - Min))
				end
			end)

			UserInputService.InputEnded:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1 then
					Dragging = false
				end
			end)

			SliderBtn.MouseEnter:Connect(function()
				FastTween(Knob, {Size = UDim2.fromOffset(ScaledNumber(12), ScaledNumber(12))})
			end)

			SliderBtn.MouseLeave:Connect(function()
				if not Dragging then
					FastTween(Knob, {Size = UDim2.fromOffset(ScaledNumber(10), ScaledNumber(10))})
				end
			end)

			local SliderObj = {
				Type = "Slider",
				GetValue = function() return Value end,
				Set = function(V) SetValue(V) end,
				SetCallback = function(Fn) Callback = Fn end
			}

			table.insert(Section.Elements, SliderObj)
			return SliderObj
		end

