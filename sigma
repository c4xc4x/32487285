			})

			local function GetSelectedText()
				if MultiSelect then
					if #Selected == 0 then return "None" end
					local Parts = {}
					for _, V in Selected do table.insert(Parts, V) end
					return table.concat(Parts, ", ")
				end
				return Selected
			end

			local function SetOption(Option)
				if MultiSelect then
					local Found = false
					for I, V in Selected do
						if V == Option then
							table.remove(Selected, I)
							Found = true
							break
						end
					end
					if not Found then
						table.insert(Selected, Option)
					end
					DropLabel.Text = GetSelectedText()
					Callback(Selected)
				else
					Selected = Option
					DropLabel.Text = Option
					Callback(Option)
					Open = false
					OptionList.Visible = false
					FastTween(OptionList, {Size = UDim2.new(1, 0, 0, 0)})
					FastTween(Arrow, {Rotation = 0})
				end
			end

			local function BuildOptions()
				for _, Child in OptionList:GetChildren() do
					if Child:IsA("TextButton") then
						Child:Destroy()
					end
				end

				local OptionCount = 0
				for _, Option in Options do
					OptionCount = OptionCount + 1
					local OptionBtn = Create("TextButton", {
						Name = "Opt_" .. Option,
						BackgroundColor3 = COLORS.DropdownItem,
						Size = UDim2.new(1, 0, 0, ScaledNumber(22)),
						BorderSizePixel = 0,
						Font = Enum.Font.Gotham,
						Text = Option,
						TextColor3 = COLORS.Text,
						TextSize = ScaledNumber(10),
						AutoButtonColor = false,
						LayoutOrder = OptionCount,
						ZIndex = 101,
						Parent = OptionList
					})

					Create("UICorner", {CornerRadius = UDim.new(0, ScaledNumber(2)), Parent = OptionBtn})

					OptionBtn.MouseEnter:Connect(function()
						FastTween(OptionBtn, {BackgroundColor3 = COLORS.DropdownHover})
						FastTween(OptionBtn, {TextColor3 = COLORS.AccentGlow})
					end)

					OptionBtn.MouseLeave:Connect(function()
						FastTween(OptionBtn, {BackgroundColor3 = COLORS.DropdownItem})
						FastTween(OptionBtn, {TextColor3 = COLORS.Text})
					end)

					OptionBtn.MouseButton1Click:Connect(function()
						SetOption(Option)
					end)
				end

				return OptionCount
			end

			local function ToggleDropdown()
				Open = not Open
				local Count = BuildOptions()
				local TargetH = Open and math.min(Count * ScaledNumber(23) + ScaledNumber(8), ScaledNumber(120)) or 0
				OptionList.Visible = true
				FastTween(OptionList, {Size = UDim2.new(1, 0, 0, TargetH)}, 0.15)
				FastTween(Arrow, {Rotation = Open and 180 or 0})
				if not Open then
					task.delay(0.15, function()
						OptionList.Visible = false
					end)
				end
			end

			DropBtn.MouseButton1Click:Connect(ToggleDropdown)

			DropBtn.MouseEnter:Connect(function()
				FastTween(DropBtn, {BackgroundColor3 = COLORS.SurfaceAlt})
			end)

			DropBtn.MouseLeave:Connect(function()
				FastTween(DropBtn, {BackgroundColor3 = COLORS.Dropdown})
			end)

			local DropObj = {
				Type = "Dropdown",
				GetSelected = function() return Selected end,
				Set = function(V)
					if MultiSelect then
						Selected = type(V) == "table" and V or {V}
					else
						Selected = V
					end
					DropLabel.Text = GetSelectedText()
				end,
				SetOptions = function(NewOptions)
					Options = NewOptions
				end,
				SetCallback = function(Fn) Callback = Fn end
			}

			table.insert(Section.Elements, DropObj)
			return DropObj
		end

