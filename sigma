		PaddingRight = UDim.new(0, ScaledNumber(10)),
		Parent = ContentFrame
	})

	MakeScrollable(ContentFrame, ContentLayout)

	Tab.ContentFrame = ContentFrame
	Tab.TabBtn = TabBtn

	TabBtn.MouseButton1Click:Connect(function()
		for _, T in self.Tabs do
			FastTween(T.TabBtn, {BackgroundColor3 = COLORS.TabInactive, TextColor3 = COLORS.TextMuted})
			T.TabBtn.Indicator.Visible = false
			T.ContentFrame.Visible = false
		end
		FastTween(TabBtn, {BackgroundColor3 = COLORS.TabActive, TextColor3 = COLORS.Accent})
		ActiveIndicator.Visible = true
		ContentFrame.Visible = true
		self.ActiveTab = Tab
	end)

