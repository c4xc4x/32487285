local function MakeTween(Object, Info, Props)
	return TweenService:Create(Object, Info, Props)
end

local function FastTween(Object, Props, Duration)
	return MakeTween(Object, TweenInfo.new(Duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), Props):Play()
end

local function Create(Class, Props)
	local Instance = Instance.new(Class)
	for K, V in Props do
		if K ~= "Parent" then
			Instance[K] = V
		end
	end
	if Props.Parent then
		Instance.Parent = Props.Parent
	end
	return Instance
end

local function GetViewportScale()
	local Viewport = workspace.CurrentCamera.ViewportSize
	local ScaleX = Viewport.X / 1920
	local ScaleY = Viewport.Y / 1080
	return math.min(ScaleX, ScaleY)
end

local function ScaledSize(Width, Height)
	local Scale = GetViewportScale()
	return UDim2.fromOffset(math.round(Width * Scale), math.round(Height * Scale))
end

local function ScaledOffset(X, Y)
	local Scale = GetViewportScale()
	return UDim2.fromOffset(math.round(X * Scale), math.round(Y * Scale))
end

local function ScaledNumber(N)
	return math.round(N * GetViewportScale())
end

local function MakeDraggable(Frame, Handle)
	local Dragging = false
	local DragStart = Vector2.new()
	local FrameStart = Vector2.new()

	Handle.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 then
			Dragging = true
			DragStart = Vector2.new(Input.Position.X, Input.Position.Y)
			FrameStart = Vector2.new(Frame.Position.X.Offset, Frame.Position.Y.Offset)
		end
	end)

	UserInputService.InputChanged:Connect(function(Input)
		if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
			local Delta = Vector2.new(Input.Position.X - DragStart.X, Input.Position.Y - DragStart.Y)
			Frame.Position = UDim2.fromOffset(FrameStart.X + Delta.X, FrameStart.Y + Delta.Y)
		end
	end)

	UserInputService.InputEnded:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 then
			Dragging = false
		end
	end)
end

local function MakeScrollable(ScrollFrame, ContentFrame)
	local ScrollBarHolder = Create("Frame", {
		Name = "ScrollBarHolder",
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -ScaledNumber(SCROLLBAR_WIDTH + 2), 0, 0),
		Size = UDim2.new(0, ScaledNumber(SCROLLBAR_WIDTH), 1, 0),
		Parent = ScrollFrame
	})

	local ScrollBar = Create("Frame", {
		Name = "ScrollBar",
		BackgroundColor3 = COLORS.ScrollBar,
		Size = UDim2.new(1, 0, 0.3, 0),
		Parent = ScrollBarHolder
	})

	Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = ScrollBar})

	local function UpdateScrollBar()
		local ContentHeight = ContentFrame.AbsoluteContentSize.Y
		local FrameHeight = ScrollFrame.AbsoluteSize.Y
		if ContentHeight <= FrameHeight then
			ScrollBar.Visible = false
			return
		end
		ScrollBar.Visible = true
		local Ratio = FrameHeight / ContentHeight
		local BarHeight = math.clamp(Ratio, 0.05, 1)
		local ScrollRatio = ScrollFrame.CanvasPosition.Y / (ContentHeight - FrameHeight)
		ScrollBar.Size = UDim2.new(1, 0, BarHeight, 0)
		ScrollBar.Position = UDim2.new(0, 0, ScrollRatio * (1 - BarHeight), 0)
	end

	ScrollFrame:GetPropertyChangedSignal("CanvasPosition"):Connect(UpdateScrollBar)
	ContentFrame:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateScrollBar)
	UpdateScrollBar()
end

local function RgbToHsv(R, G, B)
	local Max = math.max(R, G, B)
	local Min = math.min(R, G, B)
	local Delta = Max - Min
	local H, S, V = 0, 0, Max

	if Max ~= 0 then S = Delta / Max end
	if Delta ~= 0 then
		if Max == R then H = (G - B) / Delta % 6
		elseif Max == G then H = (B - R) / Delta + 2
		else H = (R - G) / Delta + 4
		end
		H = H / 6
		if H < 0 then H = H + 1 end
	end
	return H, S, V
end

local function HsvToRgb(H, S, V)
	local I = math.floor(H * 6)
	local F = H * 6 - I
	local P = V * (1 - S)
	local Q = V * (1 - F * S)
	local T = V * (1 - (1 - F) * S)
	local Segment = I % 6
	local R, G, B
	if Segment == 0 then R, G, B = V, T, P
	elseif Segment == 1 then R, G, B = Q, V, P
	elseif Segment == 2 then R, G, B = P, V, T
	elseif Segment == 3 then R, G, B = P, Q, V
	elseif Segment == 4 then R, G, B = T, P, V
	else R, G, B = V, P, Q
	end
	return R, G, B
end

local function Color3ToHex(Color)
	return string.format("%02X%02X%02X", math.round(Color.R * 255), math.round(Color.G * 255), math.round(Color.B * 255))
end

