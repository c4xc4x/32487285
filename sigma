	local TabName = TabConfig.Name or "Tab"
	local TabIcon = TabConfig.Icon or ""

	local Tab = {}
	Tab.Name = TabName
	Tab.Sections = {}
	Tab.Window = self

	local IsFirst = #self.Tabs == 0
	local TabIndex = #self.Tabs + 1

	local TabBtn = Create("TextButton", {
		Name = "Tab_" .. TabName,
		BackgroundColor3 = IsFirst and COLORS.TabActive or COLORS.TabInactive,
		Size = UDim2.new(1, -ScaledNumber(8), 0, ScaledNumber(34)),
		BorderSizePixel = 0,
		Font = Enum.Font.Gotham,
		Text = (TabIcon ~= "" and TabIcon .. "  " or "") .. TabName,
		TextColor3 = IsFirst and COLORS.Accent or COLORS.TextMuted,
		TextSize = ScaledNumber(11),
		AutoButtonColor = false,
		LayoutOrder = TabIndex,
		Parent = self.TabList.TabContainer
	})

	Create("UICorner", {CornerRadius = UDim.new(0, ScaledNumber(3)), Parent = TabBtn})

	local ActiveIndicator = Create("Frame", {
		Name = "Indicator",
		BackgroundColor3 = COLORS.Accent,
		Position = UDim2.fromOffset(0, ScaledNumber(8)),
		Size = UDim2.fromOffset(ScaledNumber(2), ScaledNumber(18)),
		BorderSizePixel = 0,
		Visible = IsFirst,
		Parent = TabBtn
	})

	Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = ActiveIndicator})

	local ContentFrame = Create("ScrollingFrame", {
		Name = "Content_" .. TabName,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 1, 0),
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
