				AlphaKnob.Position = UDim2.new(Alpha, 0, 0.5, 0)
				Callback(CurrentColor, Alpha)
			end

			local DraggingSV = false
			local DraggingHue = false
			local DraggingAlpha = false

			local SVBtn = Create("TextButton", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				Text = "",
				ZIndex = 210,
				Parent = SatValBox
			})

			SVBtn.InputBegan:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1 then
					DraggingSV = true
					local RelX = math.clamp((Input.Position.X - SatValBox.AbsolutePosition.X) / SatValBox.AbsoluteSize.X, 0, 1)
					local RelY = math.clamp((Input.Position.Y - SatValBox.AbsolutePosition.Y) / SatValBox.AbsoluteSize.Y, 0, 1)
					S = RelX
					V = 1 - RelY
					UpdateColor()
				end
			end)

			local HueBtn = Create("TextButton", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				Text = "",
				ZIndex = 210,
				Parent = HueBar
			})

			HueBtn.InputBegan:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1 then
					DraggingHue = true
					H = math.clamp((Input.Position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
					UpdateColor()
				end
			end)

			local AlphaBtn = Create("TextButton", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				Text = "",
				ZIndex = 210,
				Parent = AlphaBar
			})

			AlphaBtn.InputBegan:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1 then
					DraggingAlpha = true
					Alpha = math.clamp((Input.Position.X - AlphaBar.AbsolutePosition.X) / AlphaBar.AbsoluteSize.X, 0, 1)
					UpdateColor()
				end
			end)

			UserInputService.InputChanged:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseMovement then
					if DraggingSV then
						local RelX = math.clamp((Input.Position.X - SatValBox.AbsolutePosition.X) / SatValBox.AbsoluteSize.X, 0, 1)
						local RelY = math.clamp((Input.Position.Y - SatValBox.AbsolutePosition.Y) / SatValBox.AbsoluteSize.Y, 0, 1)
						S = RelX
						V = 1 - RelY
						UpdateColor()
					elseif DraggingHue then
						H = math.clamp((Input.Position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
						UpdateColor()
					elseif DraggingAlpha then
						Alpha = math.clamp((Input.Position.X - AlphaBar.AbsolutePosition.X) / AlphaBar.AbsoluteSize.X, 0, 1)
						UpdateColor()
					end
				end
			end)

			UserInputService.InputEnded:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1 then
					DraggingSV = false
					DraggingHue = false
					DraggingAlpha = false
				end
			end)

			HexInput.FocusLost:Connect(function()
				local Hex = HexInput.Text:gsub("[^%x]", ""):sub(1, 6)
				if #Hex == 6 then
					local R = tonumber(Hex:sub(1, 2), 16) / 255
					local G = tonumber(Hex:sub(3, 4), 16) / 255
					local B = tonumber(Hex:sub(5, 6), 16) / 255
					H, S, V = RgbToHsv(R, G, B)
					UpdateColor()
				end
			end)

			PreviewBtn.MouseButton1Click:Connect(function()
				Open = not Open
				PickerFrame.Visible = Open
			end)

			UserInputService.InputBegan:Connect(function(Input)
				if Open and Input.UserInputType == Enum.UserInputType.MouseButton1 then
					local Pos = Input.Position
					local PF = PickerFrame.AbsolutePosition
					local PS = PickerFrame.AbsoluteSize
					if Pos.X < PF.X or Pos.X > PF.X + PS.X or Pos.Y < PF.Y or Pos.Y > PF.Y + PS.Y then
						local PBP = PreviewBtn.AbsolutePosition
						local PBS = PreviewBtn.AbsoluteSize
						if not (Pos.X >= PBP.X and Pos.X <= PBP.X + PBS.X and Pos.Y >= PBP.Y and Pos.Y <= PBP.Y + PBS.Y) then
							Open = false
							PickerFrame.Visible = false
						end
					end
				end
			end)

			local CPObj = {
				Type = "ColorPicker",
				GetColor = function() return CurrentColor end,
				GetAlpha = function() return Alpha end,
				Set = function(Color)
					H, S, V = RgbToHsv(Color.R, Color.G, Color.B)
					UpdateColor()
				end,
				SetCallback = function(Fn) Callback = Fn end
			}

			table.insert(Section.Elements, CPObj)
			return CPObj
		end

		function Section:AddButton(Config)
			local BtnConfig = type(Config) == "string" and {Name = Config} or Config
			local Name = BtnConfig.Name or "Button"
			local Callback = BtnConfig.Callback or function() end
			local Danger = BtnConfig.Danger or false
			local ElementOrder = #Section.Elements + 1

			local Row = Create("Frame", {
				Name = "BtnRow",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, ScaledNumber(ELEMENT_HEIGHT)),
				BorderSizePixel = 0,
				LayoutOrder = ElementOrder,
				Parent = ElementContainer
			})

			local Btn = Create("TextButton", {
				Name = "Btn",
				BackgroundColor3 = Danger and Color3.fromRGB(55, 22, 22) or COLORS.SurfaceAlt,
				Position = UDim2.fromOffset(ScaledNumber(4), ScaledNumber(5)),
				Size = UDim2.new(1, -ScaledNumber(8), 0, ScaledNumber(22)),
				BorderSizePixel = 0,
				Font = Enum.Font.GothamSemibold,
				Text = Name,
				TextColor3 = Danger and COLORS.Danger or COLORS.Text,
				TextSize = ScaledNumber(11),
				AutoButtonColor = false,
				Parent = Row
			})

			Create("UICorner", {CornerRadius = UDim.new(0, ScaledNumber(3)), Parent = Btn})

			Create("UIStroke", {
				Color = Danger and COLORS.Danger or COLORS.Border,
				Transparency = 0.5,
				Thickness = ScaledNumber(1),
				Parent = Btn
			})

			local Ripple = Create("Frame", {
				Name = "Ripple",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Danger and COLORS.Danger or COLORS.Accent,
				BackgroundTransparency = 0.8,
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.fromOffset(0, 0),
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = Btn
			})

			Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Ripple})

			Btn.MouseEnter:Connect(function()
				FastTween(Btn, {BackgroundColor3 = Danger and Color3.fromRGB(75, 28, 28) or COLORS.Border})
				FastTween(Btn, {TextColor3 = Danger and Color3.fromRGB(255, 100, 100) or COLORS.Accent})
			end)

			Btn.MouseLeave:Connect(function()
				FastTween(Btn, {BackgroundColor3 = Danger and Color3.fromRGB(55, 22, 22) or COLORS.SurfaceAlt})
				FastTween(Btn, {TextColor3 = Danger and COLORS.Danger or COLORS.Text})
			end)

			Btn.MouseButton1Click:Connect(function()
				local MousePos = UserInputService:GetMouseLocation()
				local BtnPos = Btn.AbsolutePosition
				Ripple.Position = UDim2.fromOffset(MousePos.X - BtnPos.X, MousePos.Y - BtnPos.Y)
				Ripple.Size = UDim2.fromOffset(0, 0)
				Ripple.BackgroundTransparency = 0.6

				local T = MakeTween(Ripple, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Size = UDim2.fromOffset(ScaledNumber(200), ScaledNumber(200)),
					BackgroundTransparency = 1
				})
				T:Play()

				Callback()
			end)

			local BtnObj = {
				Type = "Button",
				SetCallback = function(Fn) Callback = Fn end,
				SetText = function(T) Btn.Text = T end
			}

			table.insert(Section.Elements, BtnObj)
			return BtnObj
		end

		function Section:AddInput(Config)
			local InputConfig = type(Config) == "string" and {Name = Config} or Config
			local Name = InputConfig.Name or "Input"
			local Default = InputConfig.Default or ""
			local Placeholder = InputConfig.Placeholder or "Enter text..."
			local Numeric = InputConfig.Numeric or false
			local Callback = InputConfig.Callback or function() end
			local ElementOrder = #Section.Elements + 1

			local Row = Create("Frame", {
				Name = "InputRow",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, ScaledNumber(ELEMENT_HEIGHT + 4)),
				BorderSizePixel = 0,
				LayoutOrder = ElementOrder,
				Parent = ElementContainer
			})

			local Label = Create("TextLabel", {
				Name = "Label",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(ScaledNumber(4), 0),
				Size = UDim2.new(0.4, 0, 0, ScaledNumber(ELEMENT_HEIGHT)),
				Font = Enum.Font.Gotham,
				Text = Name,
				TextColor3 = COLORS.Text,
				TextSize = ScaledNumber(11),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Row
			})

			local InputBox = Create("TextBox", {
				Name = "Input",
				BackgroundColor3 = COLORS.SurfaceAlt,
				Position = UDim2.new(0.4, 0, 0.5, -ScaledNumber(11)),
				Size = UDim2.new(0.6, -ScaledNumber(4), 0, ScaledNumber(22)),
				BorderSizePixel = 0,
				Font = Enum.Font.Gotham,
				Text = Default,
				PlaceholderText = Placeholder,
				PlaceholderColor3 = COLORS.TextDim,
				TextColor3 = COLORS.Text,
				TextSize = ScaledNumber(10),
				ClearTextOnFocus = false,
				Parent = Row
			})

			Create("UICorner", {CornerRadius = UDim.new(0, ScaledNumber(3)), Parent = InputBox})

			local InputStroke = Create("UIStroke", {
				Color = COLORS.Border,
				Thickness = ScaledNumber(1),
				Parent = InputBox
			})

			InputBox.Focused:Connect(function()
				FastTween(InputStroke, {Color = COLORS.Accent})
			end)

			InputBox.FocusLost:Connect(function(EnterPressed)
				FastTween(InputStroke, {Color = COLORS.Border})
				if Numeric then
					local Num = tonumber(InputBox.Text)
					InputBox.Text = Num and tostring(Num) or Default
				end
				Callback(InputBox.Text, EnterPressed)
			end)

			local InpObj = {
				Type = "Input",
				GetValue = function() return InputBox.Text end,
				Set = function(V) InputBox.Text = V end,
				SetCallback = function(Fn) Callback = Fn end
			}

			table.insert(Section.Elements, InpObj)
			return InpObj
		end

		function Section:AddKeybind(Config)
			local KBConfig = type(Config) == "string" and {Name = Config} or Config
			local Name = KBConfig.Name or "Keybind"
			local Default = KBConfig.Default or Enum.KeyCode.F
			local Callback = KBConfig.Callback or function() end
			local ElementOrder = #Section.Elements + 1

			local BoundKey = Default
			local Listening = false

			local Row, Label = MakeElementBase(Name, ElementOrder)

			local KeyBtn = Create("TextButton", {
				Name = "KeyBtn",
				BackgroundColor3 = COLORS.SurfaceAlt,
				Position = UDim2.new(1, -ScaledNumber(70), 0.5, -ScaledNumber(11)),
				Size = UDim2.fromOffset(ScaledNumber(62), ScaledNumber(22)),
				BorderSizePixel = 0,
				Font = Enum.Font.GothamSemibold,
				Text = BoundKey.Name,
				TextColor3 = COLORS.Accent,
				TextSize = ScaledNumber(9),
				AutoButtonColor = false,
				Parent = Row
			})

			Create("UICorner", {CornerRadius = UDim.new(0, ScaledNumber(3)), Parent = KeyBtn})

			Create("UIStroke", {
				Color = COLORS.Border,
				Thickness = ScaledNumber(1),
				Parent = KeyBtn
			})

			KeyBtn.MouseButton1Click:Connect(function()
				Listening = not Listening
				KeyBtn.Text = Listening and "..." or BoundKey.Name
				KeyBtn.TextColor3 = Listening and COLORS.AccentGlow or COLORS.Accent
			end)

			UserInputService.InputBegan:Connect(function(Input)
				if Listening and Input.UserInputType == Enum.UserInputType.Keyboard then
					BoundKey = Input.KeyCode
					Listening = false
					KeyBtn.Text = BoundKey.Name
					KeyBtn.TextColor3 = COLORS.Accent
					Callback(BoundKey)
				elseif not Listening and Input.KeyCode == BoundKey then
					Callback(BoundKey)
				end
			end)

			local KBObj = {
				Type = "Keybind",
				GetKey = function() return BoundKey end,
				Set = function(Key) BoundKey = Key; KeyBtn.Text = Key.Name end,
				SetCallback = function(Fn) Callback = Fn end
			}

			table.insert(Section.Elements, KBObj)
			return KBObj
		end

		function Section:AddLabel(Text)
			local ElementOrder = #Section.Elements + 1

			local Row = Create("Frame", {
				Name = "LabelRow",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, ScaledNumber(24)),
				BorderSizePixel = 0,
				LayoutOrder = ElementOrder,
				Parent = ElementContainer
			})

			local Lbl = Create("TextLabel", {
				Name = "Label",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(ScaledNumber(4), 0),
				Size = UDim2.new(1, -ScaledNumber(8), 1, 0),
				Font = Enum.Font.Gotham,
				Text = Text,
				TextColor3 = COLORS.TextMuted,
				TextSize = ScaledNumber(10),
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Row
			})

			local LblObj = {
				Type = "Label",
				SetText = function(T) Lbl.Text = T end,
				SetColor = function(C) Lbl.TextColor3 = C end
			}

			table.insert(Section.Elements, LblObj)
			return LblObj
		end

		function Section:AddSeparator()
			local ElementOrder = #Section.Elements + 1

			local Row = Create("Frame", {
				Name = "SepRow",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, ScaledNumber(16)),
				BorderSizePixel = 0,
				LayoutOrder = ElementOrder,
				Parent = ElementContainer
			})

			local Line = Create("Frame", {
				Name = "Line",
				BackgroundColor3 = COLORS.Border,
				Position = UDim2.new(0, ScaledNumber(4), 0.5, 0),
				Size = UDim2.new(1, -ScaledNumber(8), 0, ScaledNumber(1)),
				BorderSizePixel = 0,
				Parent = Row
			})

			table.insert(Section.Elements, {Type = "Separator"})
		end

		return Section
	end

	return Tab
end

function WindowClass:Notify(Config)
	local NotifConfig = type(Config) == "string" and {Title = Config} or Config
	local Title = NotifConfig.Title or "Notification"
	local Message = NotifConfig.Message or ""
	local Duration = NotifConfig.Duration or 4
	local NotifType = NotifConfig.Type or "Info"

	local AccentColor = COLORS.Accent
	if NotifType == "Error" then AccentColor = COLORS.Danger
	elseif NotifType == "Success" then AccentColor = COLORS.Success
	end

	local NotifHolder = self.ScreenGui:FindFirstChild("NotifHolder")
	if not NotifHolder then
		NotifHolder = Create("Frame", {
			Name = "NotifHolder",
			BackgroundTransparency = 1,
			Position = UDim2.new(1, -ScaledNumber(280), 1, -ScaledNumber(20)),
			Size = UDim2.fromOffset(ScaledNumber(260), ScaledNumber(0)),
			AnchorPoint = Vector2.new(0, 1),
			Parent = self.ScreenGui
		})

		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, ScaledNumber(6)),
			Parent = NotifHolder
		})
	end

	local NotifFrame = Create("Frame", {
		Name = "Notif",
		BackgroundColor3 = COLORS.Surface,
		Size = UDim2.fromOffset(ScaledNumber(260), ScaledNumber(0)),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		Parent = NotifHolder
	})

	Create("UICorner", {CornerRadius = UDim.new(0, ScaledNumber(4)), Parent = NotifFrame})

	local NotifBorder = Create("UIStroke", {
		Color = AccentColor,
		Transparency = 0.5,
		Thickness = ScaledNumber(1),
		Parent = NotifFrame
	})

	local ColorBar = Create("Frame", {
		Name = "Bar",
		BackgroundColor3 = AccentColor,
		Size = UDim2.fromOffset(ScaledNumber(3), ScaledNumber(0)),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		Parent = NotifFrame
	})

	Create("UICorner", {CornerRadius = UDim.new(0, ScaledNumber(2)), Parent = ColorBar})

	local NotifInner = Create("Frame", {
		Name = "Inner",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(ScaledNumber(10), ScaledNumber(8)),
		Size = UDim2.new(1, -ScaledNumber(14), 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = NotifFrame
	})

	local NotifTitle = Create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, ScaledNumber(16)),
		Font = Enum.Font.GothamBold,
		Text = Title,
		TextColor3 = AccentColor,
		TextSize = ScaledNumber(11),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = NotifInner
	})

	if Message ~= "" then
		local NotifMsg = Create("TextLabel", {
			Name = "Message",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, ScaledNumber(18)),
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Font = Enum.Font.Gotham,
			Text = Message,
			TextColor3 = COLORS.TextMuted,
			TextSize = ScaledNumber(10),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = NotifInner
		})
	end

	local ProgressBar = Create("Frame", {
		Name = "Progress",
		BackgroundColor3 = AccentColor,
		BackgroundTransparency = 0.4,
		Position = UDim2.fromOffset(ScaledNumber(3), 0),
		Size = UDim2.new(1, -ScaledNumber(3), 0, ScaledNumber(2)),
		AnchorPoint = Vector2.new(0, 1),
		BorderSizePixel = 0,
		Parent = NotifFrame
	})

	NotifFrame.BackgroundTransparency = 1
	FastTween(NotifFrame, {BackgroundTransparency = 0}, 0.2)

	MakeTween(ProgressBar, TweenInfo.new(Duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, ScaledNumber(3), 0, ScaledNumber(2))}):Play()

	task.delay(Duration, function()
		FastTween(NotifFrame, {BackgroundTransparency = 1}, 0.3)
		task.delay(0.3, function()
			NotifFrame:Destroy()
		end)
	end)
end

function WindowClass:Destroy()
	for _, Conn in self.Connections do
		Conn:Disconnect()
	end
	self.ScreenGui:Destroy()
end

return Library
